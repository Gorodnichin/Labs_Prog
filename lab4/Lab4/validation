from __future__ import annotations
from constants import m_min,m_max,w1_min,w1_max,w2_min,w2_max,T_min,T_max
from logger import log_error
def validate_range(value: float, low: float, high: float) -> tuple[bool, str]:
    if value < low:
        return False, f"Ошибка: значение меньше нижней границы ({low})."
    elif value > high:
        return False, f"Ошибка: значение больше верхней границы ({high})."
    else:
        return True, ""
def input_number(prompt: str, low: float, high: float) -> float:
    while True:
        raw = input(prompt).strip()
        try:
            value = float(raw)
        except ValueError as e:
            msg = str(e.args[0]) if e.args else str(e)
            msg = f"Ошибка: введено не число ('{raw}'). {msg}"
            print(msg)
            log_error(msg)
            continue
        ok, msg = validate_range(value, low, high)
        if ok:
            return value
        print(msg + " Повторите ввод.")
        log_error(msg)
def input_mass() -> float:
    return input_number(
        "Введите массу m, кг (1..5000): ",
        m_min, m_max,
    )
def input_moisture1() -> float:
    return input_number(
        "Введите начальную влажность w1, % (5..60): ",
        w1_min, w1_max,
    )
def input_moisture2() -> float:
    return input_number(
            "Введите конечную влажность w2, % (0..30): ",
